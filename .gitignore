# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-nightline-qa/
**/.next/
**/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.credentials
credentials.*
secrets.*
.secrets/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment and credential files (never commit)
.env*
**/.env*
.env
.env.local
.env.staging.local

# local postgres data
/.pgdata/
/.pgdata-final-qa/
**/pgdata/
**/pgdata-*/
*.dump
*.pgdump
*.backup
*.bak
*.sql.gz
*.sql.bz2
*.sql.xz
*.zip

# local browser evidence and private/synthetic QA artifacts
/qa-artifacts/
/test-results/
/playwright-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
